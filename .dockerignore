# ═══════════════════════════════════════════════════════════════════════════
# .dockerignore — DAIOPH build-context exclusions
#
# Applies to every image built from this directory:
#   • ./Dockerfile                          (Streamlit dashboard, selective COPY)
#   • ./deployment/docker/Dockerfile.edge   (REST API, `COPY . .`)
#
# Goals: small build context, faster uploads, stable layer cache, and zero
# secrets / model weights / dev artifacts baked into images.
#
# IMPORTANT: `models/` is deliberately NOT excluded as a directory — it is
# also a Python source package (models.registry, models.local, ...) imported
# at runtime. Only model *weight binaries* are excluded below. Real weights
# are downloaded at runtime into the `qwen_models` volume (see
# docker-compose.yml) and never live in the image.
# ═══════════════════════════════════════════════════════════════════════════

# ── Secrets — NEVER bake into an image; inject via env vars / volumes ───────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
.secrets/
secrets/
.streamlit/secrets.toml

# ── Version control & CI ────────────────────────────────────────────────────
.git/
.gitattributes
.gitignore
.github/
.gitlab-ci.yml
.pre-commit-config.yaml

# ── IDE / editor state ──────────────────────────────────────────────────────
.vscode/
.idea/
.cursor/
*.swp

# ── Python bytecode & packaging artifacts ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/
build/
dist/

# ── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Test / type-check / coverage caches ─────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Tests & benchmarks (not needed in production images) ────────────────────
tests/
benchmarks/

# ── Docs, research & release metadata ───────────────────────────────────────
*.md
LICENSE
VERSION
docs/
research/

# ── Deployment & infra configs (host-side only; not needed inside images) ───
deployment/
Dockerfile
Dockerfile.*
.dockerignore
docker-compose.yml
docker-compose.*.yml
Makefile

# ── Frontend / Node (TS plugin & web/mobile apps — not for Python images) ───
node_modules/
corsair-plugin-edge-ai/
apps/web/
apps/mobile/
*.tsbuildinfo

# ── Model weight binaries (fetched at runtime into the qwen_models volume) ──
*.gguf
*.ggml
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt
*.h5
*.tflite
*.pb
*.bin

# ── Runtime data, logs & local state (mounted as volumes instead) ───────────
data/
runtime_data/
experiments/
logs/
logs.csv
*.log
*.sqlite
*.sqlite3
*.db
.cache/
.gradio/
flagged/

# ── Dev / debug scratch files & toolchain metadata ──────────────────────────
scratch.py
scratch2.py
scratch_test.py
diagnose.py
check_libs.py
*.bak
packages.txt
.python-version

# ── OS junk ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini